/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The waitlist page fetches /api/waitlist. _headers COMBINES matching rules, so
# adding a CSP here alone left the /* connect-src 'none' ALSO enforced and the
# browser applied the intersection - blocking the very fetch this rule intends
# to allow. DETACH the inherited CSP first, then re-add the waitlist policy in
# this same rule, so exactly ONE policy is enforced. (Unlike /log/*, this page
# has NO meta CSP, so the header must carry the full policy - detach alone
# would leave the page with no CSP at all.) The re-added policy is the /*
# policy with two deliberate differences: connect-src 'self' (the signup fetch)
# and form-action 'self'; frame-ancestors 'none' is preserved here, and the
# other /* security headers are untouched.
#
# BOTH paths are listed deliberately. Workers Assets serves this page at the
# EXTENSIONLESS canonical URL /waitlist (a request for /waitlist.html 307s to
# it), and _headers matches the REQUEST path - so a rule on /waitlist.html
# alone never applies to the page a rider actually renders. /waitlist carries
# the policy for the real page; /waitlist.html keeps it for the redirect and
# for any direct .html request.
/waitlist
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none';

/waitlist.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none';

# Log pages need to fetch /api/feedback. _headers COMBINES matching rules, so a
# second Content-Security-Policy line here would be enforced ALONGSIDE the /*
# one, leaving connect-src 'none' active and still blocking the fetch. Instead
# DETACH the inherited CSP header (Cloudflare's documented "! <header>" form),
# leaving the log page's own meta CSP (connect-src 'self') as the single active
# policy. The other /* security headers (X-Frame-Options: DENY, Referrer-Policy,
# X-Content-Type-Options, Permissions-Policy, HSTS) are NOT detached and still
# apply - X-Frame-Options: DENY preserves the anti-framing protection the
# detached CSP carried via frame-ancestors (which a meta CSP cannot express).
/log/*
  ! Content-Security-Policy
